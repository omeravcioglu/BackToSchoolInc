/* School report: the graded report card and school facts, the "why?" sticky, reputation, alerts and promises. */

.rpt-scroll { flex-grow: 1; }

.rpt-empty {
    font-size: 18px;
    color: #3F5F93;
    white-space: normal;
}

/* The report card */

.rpt-card {
    width: 470px;
    flex-shrink: 0;
    margin-right: 18px;
}

.rpt-card-head {
    flex-shrink: 0;
    padding: 0 0 4px 6px;
}

.rpt-title { font-size: 38px; }

.rpt-sub {
    font-size: 18px;
    color: #3F5F93;
    margin-top: -4px;
    overflow: hidden;
    text-overflow: ellipsis;
}

.rpt-card-content { padding: 4px 8px 8px 2px; }

.rpt-stat {
    flex-direction: row;
    align-items: center;
    height: 38px;
    padding: 0 10px 0 6px;
    margin-bottom: 2px;
    --ink-border: #1E3A6D;
    --ink-radius: "14 8 12 10 / 10 12 8 14";
}

.rpt-stat--b { --ink-radius: "8 14 10 12 / 12 10 14 8"; }

.rpt-stat:hover { --ink-fill: #EEF5FD; }

.rpt-stat--on {
    --ink-fill: #DCEBFB;
    --ink-border-width: 2.5;
    --ink-shadow: #2F6FD0;
    --ink-shadow-x: 3;
    --ink-shadow-y: 4;
}

.rpt-stat--on:hover { --ink-fill: #DCEBFB; }

.rpt-stat-icon {
    width: 30px;
    height: 30px;
    flex-shrink: 0;
    margin-right: 10px;
    align-items: center;
    justify-content: center;
    --ink-fill: #FBFDFF;
    --ink-border: #1E3A6D;
    --ink-border-width: 2;
    --ink-radius: "50% 44% 52% 46% / 46% 52% 44% 50%";
}

.rpt-stat-name {
    flex-grow: 1;
    flex-shrink: 1;
    font-size: 14px;
    overflow: hidden;
    text-overflow: ellipsis;
}

.bar.rpt-stat-bar {
    width: 114px;
    height: 12px;
    flex-shrink: 0;
}

/* Wide enough for "100" with a little air after the bar. */
.rpt-stat-value {
    width: 40px;
    flex-shrink: 0;
    margin-left: 6px;
    margin-right: 8px;
    font-size: 24px;
    -unity-text-align: middle-right;
}

.rpt-value--low { color: #B23C20; }

.rpt-grade {
    width: 30px;
    height: 30px;
    flex-shrink: 0;
    margin-right: 8px;
    align-items: center;
    justify-content: center;
    --ink-fill: #FBFDFF;
    --ink-border: #1E3A6D;
    --ink-border-width: 2;
    --ink-radius: "50% 44% 52% 46% / 46% 52% 44% 50%";
}

.rpt-grade-letter { font-size: 20px; }

.rpt-grade--top {
    --ink-fill: #DCEBFB;
    --ink-border: #1F5CB8;
}

.rpt-grade--top > .rpt-grade-letter { color: #1F5CB8; }

.rpt-grade--low {
    --ink-fill: #FFE3DA;
    --ink-border: #B23C20;
}

.rpt-grade--low > .rpt-grade-letter { color: #B23C20; }

.rpt-trend {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
}

/* School facts */

.rpt-facts {
    margin: 10px 4px 4px 4px;
    padding: 8px 12px 8px 12px;
    --ink-fill: #FBFDFF;
    --ink-border: #9CC3EC;
    --ink-border-width: 2;
    --ink-dash: 6;
    --ink-radius: "10 14 8 12 / 12 8 14 10";
}

.rpt-facts-title { font-size: 22px; }

.rpt-fact-grid {
    flex-direction: row;
    flex-wrap: wrap;
}

.rpt-fact {
    width: 50%;
    min-height: 32px;
    flex-direction: row;
    align-items: center;
    padding: 1px 6px 1px 2px;
    border-radius: 8px;
}

.rpt-fact--link:hover { background-color: rgba(220, 235, 251, 0.6); }

.rpt-fact-icon {
    width: 18px;
    height: 18px;
    margin-right: 6px;
}

.rpt-fact-words {
    flex-grow: 1;
    flex-shrink: 1;
}

.rpt-fact-label {
    font-size: 10px;
    color: #3F5F93;
}

.rpt-fact-value {
    font-size: 12px;
    white-space: normal;
}

.rpt-fact-value--bad { color: #C2462A; }

.rpt-fact-go {
    width: 14px;
    height: 14px;
    margin-left: 4px;
}

/* Why? */

.rpt-why-col {
    width: 320px;
    flex-shrink: 0;
    margin-right: 18px;
}

.rpt-why-content { padding: 16px 8px 10px 2px; }

.rpt-why {
    padding: 18px 18px 14px 18px;
    --ink-fill: #FFF3C4;
    --ink-border: #1E3A6D;
    --ink-border-width: 2;
    --ink-shadow: #1E3A6D;
    --ink-shadow-x: 4;
    --ink-shadow-y: 5;
    --ink-radius: "4 7 5 6";
}

.rpt-why-tape {
    left: 118px;
    top: -12px;
    width: 80px;
    height: 24px;
    rotate: 2deg;
}

.rpt-kicker {
    font-size: 21px;
    color: #3F5F93;
}

.rpt-why-head {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
}

.rpt-why-name {
    flex-grow: 1;
    flex-shrink: 1;
    font-size: 28px;
    white-space: normal;
}

.rpt-why-value {
    min-width: 50px;
    height: 44px;
    flex-shrink: 0;
    margin-left: 8px;
    padding: 0 8px 0 8px;
    font-size: 30px;
    -unity-text-align: middle-center;
    background-color: #FFE066;
    border-top-left-radius: 22px;
    border-top-right-radius: 16px;
    border-bottom-right-radius: 24px;
    border-bottom-left-radius: 14px;
    rotate: -3deg;
}

.rpt-factor {
    flex-direction: row;
    align-items: center;
    min-height: 22px;
    margin-bottom: 1px;
}

.rpt-factor-label {
    flex-grow: 1;
    flex-shrink: 1;
    font-size: 12px;
    white-space: normal;
}

.rpt-factor-bar {
    width: 64px;
    height: 10px;
    flex-shrink: 0;
    flex-direction: row;
    margin-left: 6px;
}

.rpt-factor-half {
    flex-grow: 1;
    flex-basis: 0;
    flex-direction: row;
}

.rpt-factor-half--minus {
    justify-content: flex-end;
    border-right-width: 1.5px;
    border-color: #C9A93A;
}

.rpt-factor-fill {
    height: 100%;
    background-color: #5A9BEA;
    border-width: 1.5px;
    border-color: #1E3A6D;
    border-radius: 3px;
}

.rpt-factor-fill--minus { background-color: #FF8C6E; }

.rpt-factor-value {
    width: 42px;
    flex-shrink: 0;
    font-size: 12px;
    color: #1F5CB8;
    -unity-text-align: middle-right;
}

.rpt-factor-value--minus { color: #B23C20; }

.rpt-dash {
    height: 2px;
    margin-top: 6px;
    --dash-color: #1E3A6D;
    --dash-on: 5;
    --dash-off: 4;
}

.rpt-total {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 4px;
}

.rpt-total-text { font-size: 14px; }

.rpt-why-note {
    font-size: 20px;
    color: #1F5CB8;
    white-space: normal;
    margin-top: 8px;
}

.rpt-links {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 4px;
}

.rpt-link {
    flex-direction: row;
    align-items: center;
    margin-right: 14px;
}

.rpt-link-icon {
    width: 16px;
    height: 16px;
    margin-right: 4px;
    --icon-ink: #2F6FD0;
}

.rpt-link-label {
    font-size: 20px;
    color: #2F6FD0;
}

.rpt-link:hover > .rpt-link-label { color: #1E3A6D; }
.rpt-link:hover > .rpt-link-icon { --icon-ink: #1E3A6D; }

/* Reputation */

.rpt-side {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
}

.rpt-head {
    flex-direction: row;
    align-items: flex-end;
    justify-content: space-between;
    margin-bottom: 4px;
}

.rpt-head-title { font-size: 25px; }

.rpt-head-note {
    font-size: 17px;
    color: #3F5F93;
    margin: 0 0 3px 8px;
}

.rpt-rep {
    flex-shrink: 0;
    padding: 10px 14px 10px 14px;
    margin: 0 6px 12px 0;
    --ink-fill: #FBFDFF;
    --ink-border: #1E3A6D;
    --ink-border-width: 2;
    --ink-shadow: #1E3A6D;
    --ink-shadow-x: 3;
    --ink-shadow-y: 4;
    --ink-radius: "16 8 14 10 / 10 14 8 16";
}

.rpt-rep-row {
    flex-direction: row;
    align-items: center;
    height: 24px;
    padding: 0 4px 0 4px;
    --ink-radius: "8 6 8 6";
}

.rpt-rep-row:hover { --ink-fill: #EEF5FD; }
.rpt-rep-row--on { --ink-fill: #DCEBFB; }
.rpt-rep-row--on:hover { --ink-fill: #DCEBFB; }

.rpt-rep-dash {
    height: 2px;
    margin: 3px 0 3px 0;
    --dash-color: #BCD5F0;
}

.rpt-rep-name {
    width: 92px;
    flex-shrink: 0;
    font-size: 12px;
}

.rpt-rep-track {
    flex-grow: 1;
    flex-shrink: 1;
    height: 14px;
    justify-content: center;
}

.bar.rpt-rep-bar {
    height: 8px;
    border-width: 1.5px;
}

.bar.rpt-rep-bar--overall {
    height: 10px;
    border-width: 2px;
}

.bar-fill.rpt-fill--gold { background-color: #FFE066; }

/* The tick for the target a reputation drifts toward. */
.rpt-target {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 3px;
    margin-left: -1px;
    background-color: #1E3A6D;
    border-radius: 1px;
}

.rpt-target--up { background-color: #2F6FD0; }
.rpt-target--down { background-color: #C2462A; }

.rpt-rep-value {
    width: 30px;
    flex-shrink: 0;
    font-size: 13px;
    -unity-text-align: middle-right;
}

.rpt-rep-trend {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
    margin-left: 6px;
}

/* Needs attention */

.rpt-side-content { padding: 14px 8px 8px 2px; }

.rpt-alerts {
    padding: 14px 16px 12px 16px;
    margin: 0 6px 20px 2px;
    rotate: 0.6deg;
    --ink-fill: #D4E8FC;
    --ink-border: #1E3A6D;
    --ink-border-width: 2;
    --ink-shadow: #1E3A6D;
    --ink-shadow-x: 3;
    --ink-shadow-y: 4;
    --ink-radius: "4 6 5 3";
}

.rpt-alerts-tape {
    left: 40%;
    top: -11px;
    width: 74px;
    height: 22px;
    rotate: -3deg;
}

.rpt-alert {
    flex-direction: row;
    align-items: flex-start;
    padding: 3px 4px 3px 2px;
    border-radius: 8px;
}

.rpt-alert--link:hover { background-color: rgba(255, 255, 255, 0.6); }

.rpt-alert-badge {
    width: 24px;
    height: 24px;
    flex-shrink: 0;
    margin-right: 8px;
    align-items: center;
    justify-content: center;
    --ink-border: #1E3A6D;
    --ink-border-width: 1.5;
    --ink-radius: "50% 44% 52% 46% / 46% 52% 44% 50%";
}

.rpt-alert-badge--bad {
    --ink-fill: #FFE3DA;
    --ink-border: #C2462A;
}

.rpt-alert-badge--warn { --ink-fill: #FFE066; }
.rpt-alert-badge--calm { --ink-fill: #FBFDFF; }

.rpt-alert-icon {
    width: 15px;
    height: 15px;
}

.rpt-alert-text {
    flex-grow: 1;
    flex-shrink: 1;
    margin-top: 3px;
    font-size: 12px;
    white-space: normal;
}

.rpt-alert-text--bad { color: #B23C20; }
.rpt-alert-text--calm { color: #3F5F93; }

.rpt-alert-go {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
    margin: 5px 0 0 6px;
}

/* Promises */

.rpt-promises {
    padding: 12px 14px 12px 14px;
    margin: 0 6px 8px 0;
    --ink-fill: #FFFFFF;
    --ink-border: #1E3A6D;
    --ink-border-width: 2;
    --ink-shadow: #1E3A6D;
    --ink-shadow-x: 3;
    --ink-shadow-y: 4;
    --ink-radius: "12 18 10 16 / 16 10 18 12";
}

.rpt-promise {
    flex-direction: row;
    align-items: flex-start;
    margin-top: 6px;
}

.rpt-promise--done { opacity: 0.75; }

.rpt-check {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    margin: 1px 8px 0 0;
    align-items: center;
    justify-content: center;
    background-color: #FBFDFF;
    border-width: 2px;
    border-color: #1E3A6D;
    border-top-left-radius: 4px;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 3px;
    border-bottom-left-radius: 5px;
}

.rpt-check-icon {
    width: 12px;
    height: 12px;
}

.rpt-promise-body {
    flex-grow: 1;
    flex-shrink: 1;
}

.rpt-promise-text {
    font-size: 13px;
    white-space: normal;
}

.rpt-promise-sub {
    font-size: 16px;
    color: #3F5F93;
    white-space: normal;
}

.rpt-chip {
    flex-shrink: 0;
    margin-left: 8px;
    padding: 1px 7px 2px 7px;
    font-size: 11px;
    border-width: 2px;
    border-top-left-radius: 9px;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 8px;
    border-bottom-left-radius: 5px;
}

.rpt-chip--kept {
    color: #1F5CB8;
    background-color: #DCEBFB;
    border-color: #1E3A6D;
}

.rpt-chip--ok {
    color: #1F5CB8;
    background-color: #FBFDFF;
    border-color: #1E3A6D;
}

.rpt-chip--open {
    background-color: #FFF3C4;
    border-color: #1E3A6D;
}

.rpt-chip--late {
    color: #C2462A;
    background-color: #FFF4F0;
    border-color: #C2462A;
}

.rpt-chip--broken {
    color: #B23C20;
    background-color: #FFE3DA;
    border-color: #C2462A;
}
