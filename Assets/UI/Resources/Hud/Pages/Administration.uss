/* Administration: a desk card per director role (filled or dashed and empty), the office desks
   and the standing orders the directors follow. */

.adm-scroll { flex-grow: 1; }

/* The padding keeps the cards' ink shadows clear of the scroll view's edge. */
.adm-body {
    flex-grow: 1;
    flex-direction: row;
    justify-content: center;
    padding: 0 5px 6px 0;
}

.adm-head {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.adm-title { font-size: 28px; }

.adm-head-note {
    font-size: 20px;
    color: #3F5F93;
    margin-left: 12px;
}

/* Locked */

.adm-locked {
    width: 560px;
    flex-shrink: 1;
    align-self: center;
    align-items: center;
    margin: 20px 0 20px 0;
    padding: 28px 40px 30px 40px;
    --ink-fill: #FFFFFF;
    --ink-border: #1E3A6D;
    --ink-border-width: 2.5;
    --ink-shadow: #1E3A6D;
    --ink-shadow-x: 3;
    --ink-shadow-y: 4;
    --ink-radius: "18 10 16 12 / 12 16 10 18";
}

.adm-locked-badge {
    width: 64px;
    height: 64px;
    align-items: center;
    justify-content: center;
    margin-bottom: 12px;
    --ink-fill: #DCEBFB;
    --ink-border: #1E3A6D;
    --ink-border-width: 2.5;
    --ink-radius: "50% 44% 52% 46% / 46% 52% 44% 50%";
}

.adm-locked-title {
    font-size: 32px;
    white-space: normal;
    -unity-text-align: upper-center;
}

.adm-locked-note {
    font-size: 22px;
    color: #3F5F93;
    margin-top: 4px;
}

/* The office */

.adm-office {
    flex-grow: 1.3;
    flex-basis: 0;
    margin-right: 18px;
}

.adm-desks {
    flex-direction: row;
    align-items: center;
    padding: 4px 12px 5px 9px;
    --ink-fill: #FFF3C4;
    --ink-border: #1E3A6D;
    --ink-border-width: 2;
    --ink-radius: "14 8 12 10 / 10 12 8 14";
}

.adm-desks-text {
    font-size: 13px;
    margin-left: 6px;
}

.adm-intro {
    font-size: 19px;
    color: #3F5F93;
    white-space: normal;
    margin: 2px 0 10px 0;
}

.adm-desk-note {
    flex-direction: row;
    align-items: center;
    margin-bottom: 12px;
}

.adm-desk-text {
    flex-grow: 1;
    flex-shrink: 1;
    font-size: 13px;
    white-space: normal;
    margin-right: 12px;
}

.adm-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
}

.adm-desk {
    width: 32.3%;
    margin-bottom: 14px;
    padding: 10px 12px 10px 12px;
    transition-duration: 0.12s;
    --ink-fill: #FFFFFF;
    --ink-border: #1E3A6D;
    --ink-border-width: 2;
    --ink-shadow: #1E3A6D;
    --ink-shadow-x: 2;
    --ink-shadow-y: 3;
    --ink-radius: "16 8 14 10 / 10 14 8 16";
}

.adm-desk--filled:hover {
    translate: 0px -2px;
    --ink-fill: #F2F8FE;
}

.adm-desk--empty {
    --ink-fill: #F6FAFE;
    --ink-border: #7FA6D6;
    --ink-dash: 7;
    --ink-shadow-x: 0;
    --ink-shadow-y: 0;
}

.adm-desk-top {
    flex-direction: row;
    align-items: center;
    margin-bottom: 6px;
}

.adm-face {
    width: 50px;
    height: 58px;
    flex-shrink: 0;
    margin-right: 10px;
    align-items: center;
    justify-content: flex-end;
    overflow: hidden;
    border-top-left-radius: 14px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 12px;
    border-bottom-left-radius: 8px;
    --ink-fill: #EAF3FD;
    --ink-border: #1E3A6D;
    --ink-border-width: 2;
    --ink-radius: "14 10 12 8";
}

.adm-desk--empty .adm-face {
    justify-content: center;
    --ink-fill: #FBFDFF;
    --ink-border: #7FA6D6;
}

.adm-portrait {
    width: 42px;
    height: 52px;
}

.adm-chair {
    width: 36px;
    height: 36px;
}

.adm-who {
    flex-grow: 1;
    flex-shrink: 1;
}

.adm-role {
    font-size: 19px;
    white-space: normal;
}

.adm-name {
    font-size: 12px;
    color: #3F5F93;
    overflow: hidden;
    text-overflow: ellipsis;
}

.adm-stat {
    flex-direction: row;
    align-items: center;
    margin-top: 3px;
}

.adm-bar {
    flex-grow: 1;
    height: 9px;
    margin: 0 6px 0 6px;
}

.adm-stat-value {
    font-size: 12px;
    width: 22px;
    -unity-text-align: middle-right;
}

.adm-fact {
    font-size: 12px;
    color: #3F5F93;
    margin-left: 5px;
    flex-shrink: 1;
    white-space: normal;
}

.adm-stamp {
    position: absolute;
    right: 8px;
    top: 8px;
    font-size: 11px;
    padding: 1px 7px 2px 7px;
    rotate: 6deg;
    color: #1E3A6D;
    background-color: #FFE066;
    border-width: 2px;
    border-color: #1E3A6D;
    border-top-left-radius: 6px;
    border-top-right-radius: 3px;
    border-bottom-right-radius: 7px;
    border-bottom-left-radius: 4px;
}

.adm-stamp--bad {
    color: #C2462A;
    background-color: #FFF4F0;
    border-color: #C2462A;
    rotate: -5deg;
}

.adm-jobs {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 7px;
}

.adm-job {
    font-size: 11px;
    margin: 0 4px 4px 0;
    padding: 0 6px 1px 6px;
    background-color: #EAF3FD;
    border-width: 1.5px;
    border-color: #1E3A6D;
    border-top-left-radius: 9px;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 8px;
    border-bottom-left-radius: 5px;
}

.adm-desk--empty .adm-job {
    color: #3F5F93;
    background-color: #FBFDFF;
    border-color: #7FA6D6;
}

.adm-link {
    flex-direction: row;
    align-items: center;
    align-self: flex-start;
    margin-top: 2px;
}

.adm-link-label {
    font-size: 18px;
    color: #2F6FD0;
    margin-right: 4px;
    white-space: normal;
    flex-shrink: 1;
}

.adm-link:hover > .adm-link-label { color: #1E3A6D; }

/* Standing orders */

.adm-orders {
    flex-grow: 1;
    flex-basis: 0;
    align-self: flex-start;
    padding: 12px 18px 16px 18px;
    --ink-fill: #FFFFFF;
    --ink-border: #1E3A6D;
    --ink-border-width: 2.5;
    --ink-shadow: #1E3A6D;
    --ink-shadow-x: 3;
    --ink-shadow-y: 4;
    --ink-radius: "10 16 12 18 / 18 12 16 10";
}

.adm-group {
    flex-direction: row;
    align-items: center;
    margin-top: 10px;
}

.adm-group-title {
    font-size: 13px;
    margin-left: 6px;
}

.adm-group-who {
    font-size: 17px;
    color: #3F5F93;
    margin-left: 8px;
    flex-shrink: 1;
    overflow: hidden;
    text-overflow: ellipsis;
}

.adm-order {
    flex-direction: row;
    align-items: center;
    min-height: 38px;
    padding: 2px 4px 2px 26px;
    border-radius: 8px;
}

.adm-order--toggle:hover { background-color: rgba(220, 235, 251, 0.6); }

.adm-order-text {
    flex-grow: 1;
    flex-shrink: 1;
    margin-right: 10px;
}

.adm-order-label {
    font-size: 13px;
    white-space: normal;
}

.adm-order-note {
    font-size: 16px;
    color: #3F5F93;
}

.adm-value {
    font-size: 22px;
    min-width: 64px;
    -unity-text-align: middle-center;
}

.switch.adm-switch {
    width: 58px;
    height: 32px;
    padding: 2px 4px 2px 4px;
}

.adm-switch .switch-knob {
    width: 24px;
    height: 24px;
}

.pills.adm-pills {
    flex-wrap: wrap;
    margin: 6px 0 0 20px;
}
